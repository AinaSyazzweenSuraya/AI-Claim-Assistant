# Local development defaults. This file contains no real credentials.
# Copy variable names, but replace blank secrets and USER/PASSWORD/HOST placeholders.
# For a public Vercel website: CLAIMS_APP_MODE=public, no CLAIMS_API_TOKEN needed.
# Set CLAIMS_DATABASE_URL in Vercel; choose private + an API token for restricted access.
# Never commit your real .env. See docs/vercel-deployment.md.
CLAIMS_APP_MODE=demo
CLAIMS_LLM_MODE=demo
CLAIMS_LLM_BASE_URL=http://127.0.0.1:11434/v1
CLAIMS_LLM_MODEL=llama3.2:3b
CLAIMS_LLM_API_KEY=
# For free browser OCR with a text-only Groq/Ollama model, set this to browser.
# No OCR key or server-side OCR packages are needed for browser mode.
# vision sends images to a vision model. florence runs locally with --extra florence.
# On Vercel use browser (recommended), or vision with an available hosted vision model.
CLAIMS_RECEIPT_IMAGE_BACKEND=vision
CLAIMS_FLORENCE_DEVICE=cpu
# Required only for private mode; unused in public mode. Never use your model API key here.
CLAIMS_API_TOKEN=
# Optional persistent PostgreSQL storage (required on Vercel).
# CLAIMS_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE
# CLAIMS_ALLOWED_HOSTS=["localhost","127.0.0.1","claims.example.com"]
# CLAIMS_ROOT=/absolute/path/to/AI-Claim-Assistant
# CLAIMS_RUNTIME_DIR=/absolute/path/to/private/runtime
